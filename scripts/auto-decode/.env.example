# Copy to ~/.config/systemd/user/auto-decode.env on the ops host (chmod 0600).
# Reuses the same OAuth token Claude_Dev uses; rotate together.
#
# That is all the launcher needs. The Claude run gets only its own OAuth token
# (scripts/auto-decode/lib/claude-run.ts); the webhook stays with the launcher.
# No GitHub token: the run never pushes, and the launcher only commits locally.

CLAUDE_CODE_OAUTH_TOKEN=<paste from ~/.config/systemd/user/claude-discord.env>
DISCORD_WEBHOOK_URL=<dedicated #decode-pipeline channel webhook, ideally — separate from #alerts>
