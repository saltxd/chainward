{
  "name": "@chainward/x402-watch",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "x402 endpoint watch: a stock @x402/fetch buyer tries a seller's paid endpoints once a day, never paying, and writes a change report when one breaks or recovers.",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@x402/core": "2.27.0",
    "@x402/evm": "2.27.0",
    "@x402/fetch": "2.27.0",
    "viem": "2.56.9"
  },
  "devDependencies": {
    "@types/node": "22.19.13",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.2",
      "vite": "7.3.7",
      "rollup": "4.59.0",
      "postcss": "8.5.32",
      "chai": "6.2.2",
      "expect-type": "1.3.0",
      "nanoid": "3.3.20",
      "obug": "2.1.1",
      "picomatch": "4.0.7",
      "source-map-js": "1.2.2",
      "tinyexec": "1.0.2",
      "tinyglobby": "0.2.15",
      "tinyrainbow": "3.2.0",
      "std-env": "4.3.0",
      "es-module-lexer": "2.3.2",
      "@types/estree": "1.0.8",
      "@jridgewell/sourcemap-codec": "1.5.5"
    }
  }
}
