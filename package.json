{
  "name": "chainward",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "pnpm --filter @chainward/db generate",
    "db:migrate": "pnpm --filter @chainward/db migrate",
    "db:push": "pnpm --filter @chainward/db push",
    "db:seed": "pnpm --filter @chainward/db seed",
    "db:studio": "pnpm --filter @chainward/db studio",
    "decode:candidates": "tsx scripts/decode-candidates.ts",
    "risk:seed": "tsx scripts/risk-seed.ts",
    "decode:og-render": "tsx scripts/auto-decode/og-render.ts",
    "decode:auto": "tsx scripts/auto-decode/index.ts",
    "brief:fulfill": "tsx scripts/fulfill-briefs.ts",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@eslint/js": "^9",
    "eslint": "^9",
    "eslint-config-next": "^15.5.16",
    "globals": "^15",
    "tsx": "^4.0.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8"
  },
  "pnpm": {
    "patchedDependencies": {
      "@alchemy/wallet-apis@5.0.0-beta.25": "patches/@alchemy__wallet-apis@5.0.0-beta.25.patch",
      "@alchemy/wallet-api-types@0.1.0-alpha.30": "patches/@alchemy__wallet-api-types@0.1.0-alpha.30.patch"
    }
  }
}
