{
  "name": "chainward",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "pnpm --filter @chainward/db generate",
    "db:migrate": "pnpm --filter @chainward/db migrate",
    "db:push": "pnpm --filter @chainward/db push",
    "db:seed": "pnpm --filter @chainward/db seed",
    "db:studio": "pnpm --filter @chainward/db studio",
    "decode:candidates": "tsx scripts/decode-candidates.ts",
    "risk:seed": "tsx scripts/risk-seed.ts",
    "ofac:update": "tsx scripts/update-ofac-list.ts",
    "labels:import-csv": "tsx apps/api/scripts/labels/import-csv.mts",
    "labels:import-dataset": "tsx apps/api/scripts/labels/import-dataset.mts",
    "labels:screen": "tsx apps/api/scripts/labels/screen.mts",
    "labels:remove": "tsx apps/api/scripts/labels/remove.mts",
    "decode:og-render": "tsx scripts/auto-decode/og-render.ts",
    "decode:auto": "tsx scripts/auto-decode/index.ts",
    "brief:fulfill": "tsx scripts/fulfill-briefs.ts",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@eslint/js": "^9",
    "eslint": "^9",
    "eslint-config-next": "^15.5.16",
    "globals": "^15",
    "tsx": "^4.23.15",
    "turbo": "^2.11.11",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8"
  },
  "pnpm": {
    "overrides": {
      "@modelcontextprotocol/sdk@<1.31.0": "1.31.0",
      "sharp@<0.35.5": "0.35.5",
      "axios@<1.20.0": "1.20.0",
      "js-yaml@<3.15.2": "3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "fast-uri@>=3.0.0 <3.1.9": "3.1.9",
      "follow-redirects@<1.16.2": "1.16.2",
      "ws@>=8.0.0 <8.21.0": "8.21.0",
      "h3@>=1.0.0 <1.15.11": "1.15.11",
      "defu@<6.1.7": "6.1.7",
      "socket.io-parser@>=4.0.0 <4.2.7": "4.2.7",
      "js-cookie@>=3.0.0 <3.0.8": "3.0.8",
      "kysely@>=0.26.0 <0.28.17": "0.28.17",
      "lodash@<4.18.1": "4.18.1",
      "handlebars@>=4.0.0 <4.7.10": "4.7.10",
      "vite": "7.3.7",
      "brace-expansion@<1.1.21": "1.1.21",
      "brace-expansion@>=5.0.0 <5.0.12": "5.0.12",
      "bn.js@<4.12.3": "4.12.5",
      "fflate@>=0.7.0 <0.7.5": "0.7.5",
      "langsmith@<0.6.0": "0.6.3",
      "pbkdf2@<3.1.7": "3.1.7",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.7",
      "postcss@<8.5.23": "8.5.32",
      "uuid@>=11.0.0 <11.1.1": "11.1.1",
      "uuid@>=13.0.0 <13.0.1": "13.0.1"
    },
    "patchedDependencies": {
      "@alchemy/wallet-apis@5.0.0-beta.25": "patches/@alchemy__wallet-apis@5.0.0-beta.25.patch",
      "@alchemy/wallet-api-types@0.1.0-alpha.30": "patches/@alchemy__wallet-api-types@0.1.0-alpha.30.patch"
    }
  }
}
