{
  "name": "@chainward/indexer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "scout:run": "node dist/scout/index.js",
    "scout:dev": "tsx src/scout/index.ts"
  },
  "dependencies": {
    "@chainward/common": "workspace:*",
    "@chainward/db": "workspace:*",
    "@chainward/decode": "workspace:*",
    "@chainward/observatory": "workspace:*",
    "bullmq": "^6.3.11",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0",
    "undici": "^8.11.2",
    "viem": "^2.57.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "pino-pretty": "^13.2.0",
    "tsup": "^8.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
