{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "@chainward/api#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/deliverables/*/*.md", "$TURBO_ROOT$/scripts/build-decode-manifest.mjs"],
      "outputs": ["dist/**", "src/data/decode-manifest.json"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["TEST_DB_URL"]
    },
    "clean": {
      "cache": false
    }
  }
}
